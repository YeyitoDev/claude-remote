# Copiar a .env solo si quieres fijar valores; todo tiene default razonable.

# --- rutas ---
# Raíz donde se crean las carpetas de proyecto. Los usuarios no eligen rutas.
CR_WORKSPACE=~/claude-remote-workspace
# Metadata, historiales y log de uso
# CR_DATA_DIR=~/.claude-remote

# --- red ---
CR_PORT=8787
CR_HOST=0.0.0.0

# --- acceso ---
# Token del admin en el PRIMER arranque. Si no se define, se genera y se imprime
# una sola vez. Los demás usuarios se crean desde el panel de administración.
# CR_TOKEN=

# --- modelos ---
CR_DEFAULT_MODEL=claude-opus-5
# Modelo que resume el knowledge (sin herramientas, tope de $0.25 por llamada)
CR_KNOWLEDGE_MODEL=claude-haiku-4-5
# Espera mínima entre entradas de knowledge de una misma sesión
CR_KNOWLEDGE_DEBOUNCE_MS=60000

# --- capacidad ---
# Procesos del CLI vivos a la vez en toda la instalación
CR_MAX_LIVE=8
# ms de inactividad antes de hibernar. 0 = nunca
CR_IDLE_HIBERNATE_MS=0

# --- límites por defecto de los usuarios nuevos (vacío = sin tope) ---
CR_DEFAULT_MONTHLY_USD=20
CR_DEFAULT_MAX_PROJECTS=10
CR_DEFAULT_MAX_LIVE_SESSIONS=3
